    "3. Opacity: keep 100% to see mini FPS on screen, or drag to 0% + choose Invisible (Web Only) on :8787 to hide on screen while FPS stays live on PC.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Opacity: keep 100% to see mini FPS on screen, or drag to 0% + choose Invisible (Web Only) on :8787 to hide on screen while FPS stays live on PC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Opacidad: déjala al 100% para ver el mini FPS en pantalla, o bájala al 0% + elige Invisible (Solo Web) en :8787 para ocultarlo manteniendo el FPS en vivo en PC."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Opacidade: deixe 100% para ver o mini FPS na tela, ou arraste para 0% + escolha Invisível (Só Web) no :8787 para ocultar na tela mantendo o FPS ao vivo no PC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Opacidade: deixe 100% para ver o mini FPS na tela, ou arraste para 0% + escolha Invisível (Só Web) no :8787 para ocultar na tela mantendo o FPS ao vivo no PC."
          }
        }
      }
    },
