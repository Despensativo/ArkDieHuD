    "If using in-game voice mic, open Stealth PiP and drag it off the side edge — the screen stays clean while the PC monitor remains active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If using in-game voice mic, open Stealth PiP and drag it off the side edge — the screen stays clean while the PC monitor remains active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas micrófono en el juego, abre el PiP discreto y arrástralo fuera del borde lateral — la pantalla queda limpia y el monitor en PC sigue activo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usar mic/chat no jogo, abra o PiP discreto e arraste-o para fora da borda lateral — a tela fica limpa e o monitor no PC segue ativo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usar mic/chat no jogo, abra o PiP discreto e arraste-o para fora da borda lateral — a tela fica limpa e o monitor no PC segue ativo."
          }
        }
      }
