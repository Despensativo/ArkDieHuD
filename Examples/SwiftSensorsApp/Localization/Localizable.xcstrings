    "1. Prerequisite: enable Settings -> Privacy & Security -> Developer Mode (required). Then open Settings -> Developer -> Metal HUD (keep Show Metal Performance HUD OFF).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Prerequisite: enable Settings -> Privacy & Security -> Developer Mode (required). Then open Settings -> Developer -> Metal HUD (keep Show Metal Performance HUD OFF)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Requisito previo: activa Ajustes -> Privacidad y Seguridad -> Modo de Desarrollador (obligatorio). Luego abre Ajustes -> Desarrollador -> HUD de Metal (mantén Mostrar HUD desactivado)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Pré-requisito: ative Ajustes -> Privacidade e Segurança -> Modo Desenvolvedor (obrigatório). Depois abra Ajustes -> Desenvolvedor -> HUD Metal (mantenha Mostrar HUD desligado)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Pré-requisito: ative Ajustes -> Privacidade e Segurança -> Modo Desenvolvedor (obrigatório). Depois abra Ajustes -> Desenvolvedor -> HUD Metal (mantenha Mostrar HUD desligado)."
          }
        }
      }
    },
