    "Disabled by default for security and local IPv4 consistency. Turn on to allow IPv6 DNS resolution and ICMPv6/UDP/TCP probes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled by default for security and local IPv4 consistency. Turn on to allow IPv6 DNS resolution and ICMPv6/UDP/TCP probes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto para seguridad y consistencia IPv4 local. Actívalo para permitir resolución DNS IPv6 y sondas ICMPv6/UDP/TCP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado por padrão para segurança e consistência em IPv4 local. Ative para permitir resolução DNS IPv6 e sondas ICMPv6/UDP/TCP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado por padrão para segurança e consistência em IPv4 local. Ative para permitir resolução DNS IPv6 e sondas ICMPv6/UDP/TCP."
          }
        }
      }
