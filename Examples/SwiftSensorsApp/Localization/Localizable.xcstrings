    "Enabled by default. Binds ICMP, UDP, and TCP probes directly to Wi-Fi or USB Ethernet so gaming/proxy VPN tunnels cannot mask real ISP packet loss while your game keeps using the VPN.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled by default. Binds ICMP, UDP, and TCP probes directly to Wi-Fi or USB Ethernet so gaming/proxy VPN tunnels cannot mask real ISP packet loss while your game keeps using the VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. Vincula las sondas ICMP, UDP y TCP directamente al Wi-Fi o Ethernet USB para que los túneles VPN no oculten pérdidas reales del proveedor mientras el juego sigue usando la VPN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por predefinição. Liga as sondas ICMP, UDP e TCP diretamente ao Wi-Fi ou adaptador Ethernet USB para que túneis VPN não ocultem perdas reais da operadora enquanto o jogo usa a VPN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. Amarra as sondas ICMP, UDP e TCP direto no Wi-Fi ou placa USB Ethernet para que túneis de VPN/boosters não mascarem perdas reais da operadora enquanto o jogo segue usando a VPN."
          }
        }
      }
    },
    "Enabling UDP Probe automatically switches to Simultaneous mode (ICMP + UDP + TCP) for real-time UDP measurement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabling UDP Probe automatically switches to Simultaneous mode (ICMP + UDP + TCP) for real-time UDP measurement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar la Sonda UDP habilita automáticamente el modo Simultáneo (ICMP + UDP + TCP) para medir UDP en tiempo real."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar a Sonda UDP habilita automaticamente o modo Simultâneo (ICMP + UDP + TCP) para medir UDP em tempo real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar a Sonda UDP habilita automaticamente o modo Simultâneo (ICMP + UDP + TCP) para medir UDP em tempo real."
